# Caddy do frontend Soluvia no Railway.
#  • Serve o SPA compilado (/srv) e faz fallback p/ index.html nas rotas do
#    cliente (/verificar/…, /c/…, /aceitar-convite).
#  • Repassa /api/* p/ o backend (BACKEND_URL) NO SERVIDOR — o navegador só
#    enxerga o domínio do front, então não há CORS nem cookie cross-site.
{
	admin off
	persist_config off
	auto_https off
}

# Railway injeta $PORT (fallback 8080 p/ rodar local: `docker run -p 8080:8080`).
:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# /api/* → backend. Defina BACKEND_URL = URL pública do serviço de backend,
	# ex.: https://soluvia-backend-production.up.railway.app
	# (Ao proxyar p/ HTTPS, o Caddy já ajusta o Host p/ o upstream — o Railway
	#  roteia certo pelo Host.)
	handle /api/* {
		reverse_proxy {$BACKEND_URL}
	}

	# SPA: assets reais são servidos; qualquer outra rota cai no index.html.
	handle {
		# Cabeçalhos de segurança/privacidade — só no SPA (não no /api/*, p/ não
		# duplicar CSP com a que o backend porventura mande: duas CSPs valem pela
		# interseção e quebrariam respostas legítimas).
		header {
			# A CSP existe sobretudo p/ manter a promessa de anonimato do canal de
			# relato (/c/:tenant/:canal) e do verificador público (/verificar/:token):
			# nenhum recurso de terceiro pode ser buscado pelo navegador do visitante.
			#   font-src 'self'  → trava a regressão "voltaram as fontes do Google".
			#   style-src        → sem CSS externo; 'unsafe-inline' é obrigatório
			#                      porque o app estiliza quase tudo por style={{…}}
			#                      (atributo inline) — tirar isso apagaria o layout.
			#   data:/blob:      → PDFs (pdf.js desenha em canvas, fontes embutidas
			#                      do PDF e download via URL.createObjectURL).
			#   frame-ancestors  → anticlickjacking; hoje nada embute o app em iframe.
			#                      Se um cliente algum dia for incorporar o canal no
			#                      site dele, é ESTA diretiva que precisa afrouxar.
			Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; img-src 'self' data: blob:; connect-src 'self'; media-src 'self' blob:; manifest-src 'self'"

			# Denunciante não deve vazar a URL do canal (que contém tenant) ao clicar
			# num link externo — 'no-referrer' é o único que não manda nem a origem.
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Cross-Origin-Opener-Policy "same-origin"

			# geolocation=(self): a assinatura digital pede localização com consentimento
			# explícito (GeolocationConsentModal) p/ a cadeia de custódia — não remova.
			# Câmera/microfone o produto não usa; ficam desligados.
			Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"

			# Não anuncia o servidor.
			-Server
		}

		try_files {path} /index.html
		file_server
	}
}
